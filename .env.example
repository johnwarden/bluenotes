# The env the app is running in e.g. development, testflight, production
EXPO_PUBLIC_ENV=development

# This is the semver release version of the app, pulled from package.json
EXPO_PUBLIC_RELEASE_VERSION=

# This is the commit hash that the current bundle was made from.
EXPO_PUBLIC_BUNDLE_IDENTIFIER=

# Should be formatted YYMMDDHH so that it increases for each build.
EXPO_PUBLIC_BUNDLE_DATE=0

# The log level for the app's logger transports
EXPO_PUBLIC_LOG_LEVEL=debug

# Enable debug logs for specific logger instances
EXPO_PUBLIC_LOG_DEBUG=session

# Bluesky appview DID
EXPO_PUBLIC_BLUESKY_PROXY_DID=

# Chat service DID
EXPO_PUBLIC_CHAT_PROXY_DID=

#
#
# Bluesky specific values
#
#


GEOLOCATION_URL="http://localhost:8100/ipcc"


# Sentry DSN for telemetry
EXPO_PUBLIC_SENTRY_DSN=

# Bitdrift API key. If undefined, Bitdrift will be disabled.
EXPO_PUBLIC_BITDRIFT_API_KEY=

# Dev-only passthrough value for bapp-config web worker
BAPP_CONFIG_DEV_BYPASS_SECRET=

# Statsig API endpoint for feature flags and analytics
# If not set, Statsig will be disabled (recommended for offline development)
# Production: https://events.bsky.app/v2
EXPO_PUBLIC_STATSIG_API_ENDPOINT=

#
#
# AT Protocol OAuth (see docs/oauth.md)
# Public client metadata — no client secret. Do not invent credentials.
#
#

# 1/true = force OAuth sign-in UI. 0/false = force password login.
# Unset = OAuth default on web, password fallback still available.
EXPO_PUBLIC_OAUTH=

# Public origin used to build client_id and redirect URIs.
# Default: https://bluenotes.social
EXPO_PUBLIC_OAUTH_CLIENT_ORIGIN=

# Full client_id URL. Must be fetchable and must return JSON whose client_id
# field is this same URL. Leave unset for production defaults or localhost loopback.
EXPO_PUBLIC_OAUTH_CLIENT_ID=

# Name shown on the PDS consent screen. Default: Blue Notes
EXPO_PUBLIC_OAUTH_CLIENT_NAME=

# Extra redirect URI beyond {origin}/ and {origin}/auth/web/callback
EXPO_PUBLIC_OAUTH_REDIRECT_URI=

# Handle resolver. Default https://bsky.social (leaks handle+IP to Bluesky).
EXPO_PUBLIC_OAUTH_HANDLE_RESOLVER=

# Space-separated scopes. Default includes atproto + transition scopes.
EXPO_PUBLIC_OAUTH_SCOPE=

# Native-only (not launched in this revision)
EXPO_PUBLIC_OAUTH_NATIVE_CLIENT_ID=
EXPO_PUBLIC_OAUTH_NATIVE_REDIRECT_URI=
